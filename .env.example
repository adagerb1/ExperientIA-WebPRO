# ─────────────────────────────────────────────────────────────
# ExperientIA · Variables de entorno (copiar a .env y completar)
# NUNCA subir .env al repositorio ni al control de versiones.
# ─────────────────────────────────────────────────────────────

APP_ENV=production            # production | dev
APP_URL=https://experientia.pro
APP_NAME=ExperientIA

# Orígenes permitidos por CORS (sitio y portal admin). Coma-separados.
CORS_ALLOWED_ORIGINS=https://experientia.pro,https://www.experientia.pro

# Clave para firmar tokens (JWT-like) y enlaces. Generar aleatoria larga:
#   php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=CAMBIAR_por_una_clave_larga_aleatoria

# Base de datos
DB_DRIVER=mysql              # mysql | sqlite (solo desarrollo)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=experientia
DB_USER=experientia
DB_PASS=CAMBIAR

# Correo de notificaciones internas (fallback si no hay SendGrid)
MAIL_FROM=hello@experientia.pro
MAIL_FROM_NAME=ExperientIA
MAIL_NOTIFY=hello@experientia.pro

# Rate limiting (peticiones por ventana)
RATELIMIT_PUBLIC=60          # peticiones/min por IP en endpoints públicos
RATELIMIT_AUTH=180           # peticiones/min por usuario autenticado

# ── Conectores (se configuran también desde el panel; .env es el fallback) ──
# OpenAI (AlexIA · Responses API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# SendGrid
SENDGRID_API_KEY=
# Telegram — bot comercial (público) y bot interno (admin)
TELEGRAM_BOT_COMMERCIAL_TOKEN=
TELEGRAM_BOT_INTERNAL_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp Business Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
# Pasarelas de pago
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
