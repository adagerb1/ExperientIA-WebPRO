---
/**
 * Tablero de Crecimiento — visual de centro de comando ejecutivo.
 * Motion sutil (dash-flow, pulsos) con reduced-motion respetado globalmente.
 */
import Icon from './Icon.astro';

interface Props {
  lang: string;
  class?: string;
}

const { lang, class: className } = Astro.props;

const L = {
  es: {
    titulo: 'Tablero de Crecimiento',
    vivo: 'En vivo',
    crecimiento: 'Crecimiento sostenible',
    vsTrim: 'vs. trimestre anterior',
    procesos: 'Procesos optimizados',
    automatizacion: 'Automatización',
    roi: 'Retorno del programa',
    flujo: 'Flujo de automatización',
    ingresos: 'Ingresos por canal',
  },
  en: {
    titulo: 'Growth Board',
    vivo: 'Live',
    crecimiento: 'Sustainable growth',
    vsTrim: 'vs. previous quarter',
    procesos: 'Processes optimized',
    automatizacion: 'Automation',
    roi: 'Program return',
    flujo: 'Automation flow',
    ingresos: 'Revenue by channel',
  },
  pt: {
    titulo: 'Painel de Crescimento',
    vivo: 'Ao vivo',
    crecimiento: 'Crescimento sustentável',
    vsTrim: 'vs. trimestre anterior',
    procesos: 'Processos otimizados',
    automatizacion: 'Automação',
    roi: 'Retorno do programa',
    flujo: 'Fluxo de automação',
    ingresos: 'Receita por canal',
  },
}[lang] ?? {
  titulo: 'Growth Board', vivo: 'Live', crecimiento: 'Sustainable growth', vsTrim: 'vs. previous quarter',
  procesos: 'Processes optimized', automatizacion: 'Automation', roi: 'Program return',
  flujo: 'Automation flow', ingresos: 'Revenue by channel',
};

const bars = [34, 52, 40, 66, 58, 80, 72, 92];
---

<div class:list={['dash', className]} role="img" aria-label={L.titulo}>
  <div class="dash__chrome">
    <span class="dash__dot"></span>
    <span class="dash__dot"></span>
    <span class="dash__dot"></span>
    <span class="dash__title">ExperientIA · {L.titulo}</span>
    <span class="dash__live"><i class="anim-pulse"></i>{L.vivo}</span>
  </div>

  <div class="dash__grid">
    <div class="dash__card dash__card--chart">
      <p class="dash__label">{L.crecimiento}</p>
      <p class="dash__big grad-text">+42%</p>
      <p class="dash__hint">{L.vsTrim}</p>
      <svg viewBox="0 0 220 74" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="dash-line" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#18d6f1" />
            <stop offset="1" stop-color="#7a63ff" />
          </linearGradient>
          <linearGradient id="dash-area" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="rgba(24,214,241,0.25)" />
            <stop offset="1" stop-color="rgba(24,214,241,0)" />
          </linearGradient>
        </defs>
        <path
          d="M0 62 L28 54 L56 58 L84 42 L112 46 L140 28 L168 32 L204 10 L220 12 L220 74 L0 74 Z"
          fill="url(#dash-area)"
        />
        <path
          class="dash__line"
          d="M0 62 L28 54 L56 58 L84 42 L112 46 L140 28 L168 32 L204 10 L220 12"
          fill="none"
          stroke="url(#dash-line)"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx="204" cy="10" r="3.4" fill="#18d6f1" class="anim-pulse" />
      </svg>
    </div>

    <div class="dash__card dash__card--ring">
      <p class="dash__label">{L.automatizacion}</p>
      <div class="dash__ring">
        <svg viewBox="0 0 96 96" aria-hidden="true">
          <circle cx="48" cy="48" r="40" fill="none" stroke="rgba(217,226,240,0.12)" stroke-width="7" />
          <circle
            cx="48" cy="48" r="40" fill="none"
            stroke="url(#dash-ring-g)" stroke-width="7" stroke-linecap="round"
            stroke-dasharray="196 251" transform="rotate(-90 48 48)"
          />
          <defs>
            <linearGradient id="dash-ring-g" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#18d6f1" />
              <stop offset="1" stop-color="#7a63ff" />
            </linearGradient>
          </defs>
        </svg>
        <span class="dash__ring-val">78%</span>
      </div>
      <p class="dash__hint">{L.procesos}</p>
    </div>

    <div class="dash__card dash__card--bars">
      <p class="dash__label">{L.ingresos}</p>
      <div class="dash__bars" aria-hidden="true">
        {bars.map((h, i) => (
          <span style={`--h:${h}%; --d:${i * 0.08}s`} class:list={[{ 'is-hot': i >= 6 }]}></span>
        ))}
      </div>
    </div>

    <div class="dash__card dash__card--roi">
      <p class="dash__label">{L.roi}</p>
      <p class="dash__big">3.2x</p>
      <div class="dash__spark" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
    </div>

    <div class="dash__card dash__card--flow">
      <p class="dash__label">{L.flujo}</p>
      <div class="dash__flow" aria-hidden="true">
        <span class="dash__node"><Icon name="play" size={16} /></span>
        <i class="dash__wire"></i>
        <span class="dash__node"><Icon name="gear" size={16} /></span>
        <i class="dash__wire"></i>
        <span class="dash__node dash__node--ok"><Icon name="check" size={16} /></span>
      </div>
    </div>
  </div>
</div>

<style>
  .dash {
    position: relative;
    background:
      linear-gradient(160deg, rgba(10, 27, 58, 0.92), rgba(5, 17, 38, 0.96)) padding-box,
      linear-gradient(140deg, rgba(24, 214, 241, 0.55), rgba(122, 99, 255, 0.45) 50%, rgba(217, 226, 240, 0.08)) border-box;
    border: 1px solid transparent;
    border-radius: var(--radius-lg);
    box-shadow:
      0 30px 80px -30px rgba(2, 8, 20, 0.9),
      0 0 60px -18px rgba(24, 214, 241, 0.28),
      0 0 90px -30px rgba(122, 99, 255, 0.3);
    overflow: hidden;
  }

  .dash__chrome {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.1rem;
    border-bottom: 1px solid var(--line-soft);
  }

  .dash__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(217, 226, 240, 0.16);
  }

  .dash__title {
    margin-left: 0.5rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .dash__live {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-cyan);
  }

  .dash__live i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 10px var(--accent-cyan);
  }

  .dash__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.7rem;
    padding: 0.9rem;
  }

  .dash__card {
    background: rgba(5, 17, 38, 0.55);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-sm);
    padding: 0.85rem 0.95rem;
    min-width: 0;
  }

  .dash__card--chart { grid-column: span 4; }
  .dash__card--ring { grid-column: span 2; display: grid; justify-items: start; }
  .dash__card--bars { grid-column: span 2; }
  .dash__card--roi { grid-column: span 2; }
  .dash__card--flow { grid-column: span 2; }

  .dash__label {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: 0.45rem;
  }

  .dash__big {
    font-size: 1.65rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--neutral-light);
    line-height: 1;
  }

  .dash__hint {
    font-size: 0.7rem;
    color: var(--text-tertiary);
    margin-top: 0.3rem;
  }

  .dash__card--chart svg {
    width: 100%;
    height: 74px;
    margin-top: 0.6rem;
  }

  .dash__line {
    stroke-dasharray: 6 10;
    animation: dash-flow 14s linear infinite;
  }

  .dash__ring {
    position: relative;
    width: 76px;
    height: 76px;
    margin-block: 0.2rem;
  }

  .dash__ring svg { width: 100%; height: 100%; }

  .dash__ring-val {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 1rem;
    font-weight: 700;
    color: var(--neutral-light);
  }

  .dash__bars {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 74px;
    margin-top: 0.4rem;
  }

  .dash__bars span {
    flex: 1;
    height: var(--h);
    border-radius: 3px 3px 0 0;
    background: rgba(24, 214, 241, 0.28);
    animation: bar-in 0.9s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    animation-delay: var(--d);
  }

  .dash__bars span.is-hot {
    background: var(--brand-gradient);
    box-shadow: 0 0 14px -2px rgba(24, 214, 241, 0.5);
  }

  @keyframes bar-in {
    from { transform: scaleY(0); transform-origin: bottom; }
    to { transform: scaleY(1); transform-origin: bottom; }
  }

  .dash__spark {
    display: flex;
    gap: 5px;
    margin-top: 0.7rem;
  }

  .dash__spark span {
    height: 5px;
    border-radius: 3px;
    background: rgba(122, 99, 255, 0.5);
  }

  .dash__spark span:nth-child(1) { width: 42%; }
  .dash__spark span:nth-child(2) { width: 26%; background: rgba(24, 214, 241, 0.55); }
  .dash__spark span:nth-child(3) { width: 14%; background: rgba(217, 226, 240, 0.25); }

  .dash__flow {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 0.55rem;
  }

  .dash__node {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    color: var(--accent-cyan);
    background: rgba(24, 214, 241, 0.1);
    border: 1px solid rgba(24, 214, 241, 0.3);
    flex-shrink: 0;
  }

  .dash__node--ok {
    color: #041022;
    background: var(--accent-cyan);
    box-shadow: 0 0 16px -4px var(--accent-cyan);
  }

  .dash__wire {
    flex: 1;
    height: 0;
    border-top: 2px dashed rgba(24, 214, 241, 0.4);
  }

  @media (max-width: 560px) {
    .dash__card--chart { grid-column: span 6; }
    .dash__card--ring { grid-column: span 3; }
    .dash__card--bars { grid-column: span 3; }
    .dash__card--roi { grid-column: span 3; }
    .dash__card--flow { grid-column: span 3; }
  }
</style>
