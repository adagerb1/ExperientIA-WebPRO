---
/**
 * Lockup horizontal ExperientIA: símbolo + wordmark + descriptor oficial.
 * El descriptor "Automatización · Growth · IA" es parte fija de la marca
 * y no se traduce.
 */
import BrandSymbol from './BrandSymbol.astro';

interface Props {
  variant?: 'gradient' | 'white' | 'black';
  descriptor?: boolean;
  size?: number;
  class?: string;
}

const { variant = 'gradient', descriptor = true, size = 40, class: className } = Astro.props;
const symbolVariant = variant === 'gradient' ? 'gradient' : variant;
---

<span class:list={['brand-logo', `brand-logo--${variant}`, className]} style={`--logo-h:${size}px`} translate="no">
  <BrandSymbol variant={symbolVariant} size={size} class="brand-logo__symbol" />
  <span class="brand-logo__text">
    <span class="brand-logo__word">Experient<i class="brand-logo__ia">IA</i></span>
    {descriptor && <span class="brand-logo__descriptor">Automatización · Growth · IA</span>}
  </span>
</span>

<style>
  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--logo-h) * 0.32);
    line-height: 1;
    text-decoration: none;
    user-select: none;
  }

  .brand-logo__symbol {
    flex-shrink: 0;
  }

  .brand-logo__text {
    display: flex;
    flex-direction: column;
    gap: calc(var(--logo-h) * 0.14);
  }

  .brand-logo__word {
    font-family: var(--font-sans);
    font-size: calc(var(--logo-h) * 0.62);
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--neutral-light, #f6f8fb);
  }

  .brand-logo__ia {
    font-style: normal;
    font-weight: 700;
    background: linear-gradient(100deg, #18d6f1 10%, #7a63ff 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .brand-logo__descriptor {
    font-family: var(--font-sans);
    font-size: calc(var(--logo-h) * 0.22);
    font-weight: 400;
    letter-spacing: 0.14em;
    color: var(--neutral-mid, #d9e2f0);
    opacity: 0.75;
    white-space: nowrap;
  }

  /* Variante negra: para fondos muy claros o documentación */
  .brand-logo--black .brand-logo__word { color: #0a1224; }
  .brand-logo--black .brand-logo__ia {
    background: none;
    color: #0a1224;
  }
  .brand-logo--black .brand-logo__descriptor { color: #34405a; opacity: 1; }

  /* Variante blanca: monocromática sobre fondos oscuros */
  .brand-logo--white .brand-logo__ia {
    background: none;
    color: #ffffff;
  }
</style>
