---
import PageHero from '../PageHero.astro';
import SectionCTA from '../SectionCTA.astro';
import BrandSymbol from '../BrandSymbol.astro';
import Icon from '../Icon.astro';
import { getDict, pagePath, TONNY_DAGER_URL } from '../../i18n/index.js';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getDict(lang);
const p = t.nosotros;
---

<PageHero eyebrow={p.hero.eyebrow} titulo={p.hero.titulo} sub={p.hero.sub} />

<section class="section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow reveal">{p.esencia.eyebrow}</p>
      <h2 class="h2 reveal" style="--reveal-delay:.08s">{p.esencia.titulo}</h2>
    </div>
    <div class="grid grid-4">
      {p.esencia.valores.map((v, i) => (
        <article class="card reveal" style={`--reveal-delay:${i * 0.08}s`}>
          <span class="icon-chip"><Icon name={v.icon} /></span>
          <h3 class="h3 nos__titulo">{v.titulo}</h3>
          <p class="small">{v.texto}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section nos-pers">
  <div class="bg-atmos" aria-hidden="true">
    <div class="halo halo-violet" style="width:460px;height:460px;top:-140px;left:-240px;opacity:.3;"></div>
  </div>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow reveal">{p.personalidad.eyebrow}</p>
      <h2 class="h2 reveal" style="--reveal-delay:.08s">{p.personalidad.titulo}</h2>
    </div>
    <div class="nos-pers__grid">
      <div class="nos-pers__symbol reveal" aria-hidden="true">
        <BrandSymbol variant="gradient" size={150} class="anim-float" />
      </div>
      <div class="nos-pers__rasgos">
        {p.personalidad.rasgos.map((r, i) => (
          <div class="nos-pers__rasgo reveal" style={`--reveal-delay:${i * 0.08}s`}>
            <h3 class="h3 grad-text">{r.titulo}</h3>
            <p>{r.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="section nos-eco">
  <div class="container">
    <div class="card-lum nos-eco__panel reveal">
      <div class="bg-atmos" aria-hidden="true">
        <div class="bg-skyline"></div>
        <div class="halo halo-cyan" style="width:420px;height:420px;top:-240px;right:-100px;opacity:.35;"></div>
      </div>
      <div class="nos-eco__content">
        <p class="eyebrow">{p.ecosistema.eyebrow}</p>
        <h2 class="h2">{p.ecosistema.titulo}</h2>
        <p class="lead">{p.ecosistema.texto}</p>
        <a href={TONNY_DAGER_URL} class="link-arrow" rel="noopener" target="_blank">
          {p.ecosistema.cta}
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </div>
</section>

<SectionCTA
  titulo={p.cta.titulo}
  sub={p.cta.sub}
  primaryHref={pagePath(lang, 'contacto')}
  primaryLabel={p.cta.cta}
/>

<style>
  .nos__titulo { font-size: 1.05rem; }

  .card {
    display: grid;
    gap: 0.8rem;
    align-content: start;
  }

  .nos-pers__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 860px) {
    .nos-pers__grid { grid-template-columns: 0.75fr 1.25fr; }
  }

  .nos-pers__symbol {
    display: grid;
    place-items: center;
    padding: 2.5rem;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-lg);
    background: radial-gradient(circle at 50% 40%, rgba(24, 214, 241, 0.08), transparent 70%);
  }

  .nos-pers__rasgos {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 560px) {
    .nos-pers__rasgos { grid-template-columns: repeat(2, 1fr); }
  }

  .nos-pers__rasgo {
    display: grid;
    gap: 0.4rem;
    padding-left: 1.1rem;
    border-left: 2px solid rgba(24, 214, 241, 0.4);
  }

  .nos-eco__panel {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    padding: clamp(2.5rem, 6vw, 4rem);
  }

  .nos-eco__content {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
    max-width: 44rem;
  }
</style>
