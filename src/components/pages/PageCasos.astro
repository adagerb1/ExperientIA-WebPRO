---
import PageHero from '../PageHero.astro';
import SectionCTA from '../SectionCTA.astro';
import { getDict, pagePath } from '../../i18n/index.js';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getDict(lang);
const p = t.casos;
---

<PageHero eyebrow={p.hero.eyebrow} titulo={p.hero.titulo} sub={p.hero.sub} />

<section class="section">
  <div class="container casos__list">
    {p.items.map((c, i) => (
      <article class="card card-lum caso reveal" style={`--reveal-delay:${i * 0.06}s`}>
        <header class="caso__head">
          <p class="caso__sector">{c.sector}</p>
          <h2 class="h2 caso__titulo">{c.titulo}</h2>
        </header>

        <div class="caso__body">
          <div class="caso__col">
            <h3 class="caso__label">{t.common.contexto}</h3>
            <p>{c.contexto}</p>
          </div>
          <div class="caso__col">
            <h3 class="caso__label">{t.common.intervencion}</h3>
            <p>{c.intervencion}</p>
          </div>
          <div class="caso__col caso__col--res">
            <h3 class="caso__label caso__label--accent">{t.common.resultados}</h3>
            <ul class="caso__resultados">
              {c.resultados.map((r) => (
                <li>
                  <span class="caso__valor grad-text">{r.valor}</span>
                  <span class="caso__res-label">{r.label}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </article>
    ))}
    <p class="small casos__nota reveal">{p.nota}</p>
  </div>
</section>

<SectionCTA
  titulo={t.home.ctaFinal.titulo}
  sub={t.home.ctaFinal.sub}
  primaryHref={pagePath(lang, 'contacto')}
  primaryLabel={t.home.ctaFinal.ctaPrimario}
  secondaryHref={pagePath(lang, 'soluciones')}
  secondaryLabel={t.common.verSoluciones}
/>

<style>
  .casos__list {
    display: grid;
    gap: 1.75rem;
  }

  .caso {
    display: grid;
    gap: 1.75rem;
    padding: clamp(1.75rem, 4vw, 2.75rem);
  }

  .caso__sector {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-cyan);
    margin-bottom: 0.6rem;
  }

  .caso__titulo {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
  }

  .caso__body {
    display: grid;
    gap: 1.75rem;
  }

  @media (min-width: 900px) {
    .caso__body { grid-template-columns: 1fr 1fr 1fr; }
  }

  .caso__label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: 0.6rem;
  }

  .caso__label--accent { color: var(--accent-cyan); }

  .caso__col p {
    font-size: 0.95rem;
  }

  .caso__col--res {
    border-left: none;
    padding-left: 0;
  }

  @media (min-width: 900px) {
    .caso__col--res {
      border-left: 1px solid var(--line-soft);
      padding-left: 1.75rem;
    }
  }

  .caso__resultados {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .caso__resultados li {
    display: grid;
    gap: 0.15rem;
  }

  .caso__valor {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1;
  }

  .caso__res-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .casos__nota {
    text-align: center;
  }
</style>
