---
import PageHero from '../PageHero.astro';
import SectionCTA from '../SectionCTA.astro';
import Icon from '../Icon.astro';
import { getDict, pagePath } from '../../i18n/index.js';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getDict(lang);
const p = t.soluciones;

const labels = {
  es: { problema: 'El problema', como: 'Cómo lo hacemos', cambia: 'Qué cambia en el negocio' },
  en: { problema: 'The problem', como: 'How we do it', cambia: 'What changes in the business' },
  pt: { problema: 'O problema', como: 'Como fazemos', cambia: 'O que muda no negócio' },
}[lang] ?? { problema: 'The problem', como: 'How we do it', cambia: 'What changes in the business' };
---

<PageHero eyebrow={p.hero.eyebrow} titulo={p.hero.titulo} sub={p.hero.sub} />

<section class="section sol-list">
  <div class="container sol-list__grid">
    {p.items.map((s, i) => (
      <article class="card card-lum sol-item reveal" style={`--reveal-delay:${(i % 2) * 0.08}s`}>
        <header class="sol-item__head">
          <span class="icon-chip"><Icon name={s.icon} /></span>
          <div>
            <p class="sol-item__pilar">{s.pilar}</p>
            <h2 class="h3">{s.titulo}</h2>
          </div>
        </header>

        <div class="sol-item__block">
          <h3 class="sol-item__label">{labels.problema}</h3>
          <p>{s.problema}</p>
        </div>

        <div class="sol-item__block">
          <h3 class="sol-item__label">{labels.como}</h3>
          <ul class="sol-item__list">
            {s.como.map((c) => (
              <li>
                <span class="sol-item__check"><Icon name="check" size={13} /></span>
                {c}
              </li>
            ))}
          </ul>
        </div>

        <div class="sol-item__block sol-item__block--cambia">
          <h3 class="sol-item__label sol-item__label--accent">{labels.cambia}</h3>
          <p>{s.cambia}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<section class="section metodo">
  <div class="bg-atmos" aria-hidden="true">
    <div class="halo halo-violet" style="width:480px;height:480px;top:-160px;right:-240px;opacity:.3;"></div>
  </div>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow reveal">{p.metodo.eyebrow}</p>
      <h2 class="h2 reveal" style="--reveal-delay:.08s">{p.metodo.titulo}</h2>
    </div>
    <ol class="metodo__steps">
      {p.metodo.pasos.map((paso, i) => (
        <li class="card reveal" style={`--reveal-delay:${i * 0.1}s`}>
          <span class="metodo__num grad-text">{paso.num}</span>
          <h3 class="h3">{paso.titulo}</h3>
          <p>{paso.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<SectionCTA
  titulo={t.home.ctaFinal.titulo}
  sub={t.home.ctaFinal.sub}
  primaryHref={pagePath(lang, 'contacto')}
  primaryLabel={t.home.ctaFinal.ctaPrimario}
  secondaryHref={pagePath(lang, 'tablero')}
  secondaryLabel={t.common.verTablero}
/>

<style>
  .sol-list__grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .sol-list__grid { grid-template-columns: repeat(2, 1fr); }
  }

  .sol-item {
    display: grid;
    gap: 1.4rem;
    align-content: start;
    padding: 2rem;
  }

  .sol-item__head {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .sol-item__pilar {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-violet);
    margin-bottom: 0.25rem;
  }

  .sol-item__label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: 0.5rem;
  }

  .sol-item__label--accent { color: var(--accent-cyan); }

  .sol-item__block--cambia {
    border-top: 1px solid var(--line-soft);
    padding-top: 1.2rem;
  }

  .sol-item__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .sol-item__list li {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .sol-item__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 6px;
    color: var(--accent-cyan);
    background: rgba(24, 214, 241, 0.1);
    border: 1px solid rgba(24, 214, 241, 0.28);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .metodo__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    counter-reset: paso;
  }

  @media (min-width: 760px) {
    .metodo__steps { grid-template-columns: repeat(4, 1fr); }
  }

  .metodo__steps li {
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }

  .metodo__num {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
  }
</style>
