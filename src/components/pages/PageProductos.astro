---
import PageHero from '../PageHero.astro';
import SectionCTA from '../SectionCTA.astro';
import Icon from '../Icon.astro';
import { getDict, pagePath } from '../../i18n/index.js';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getDict(lang);
const p = t.productos;

const hrefFor = (item) => (item.destacado ? pagePath(lang, 'tablero') : pagePath(lang, 'contacto'));
---

<PageHero eyebrow={p.hero.eyebrow} titulo={p.hero.titulo} sub={p.hero.sub} />

<section class="section">
  <div class="container prod__grid">
    {p.items.map((item, i) => (
      <article
        class:list={['card prod__card reveal', { 'card-lum prod__card--destacado': item.destacado }]}
        style={`--reveal-delay:${i * 0.08}s`}
      >
        <div class="prod__head">
          <span class="icon-chip"><Icon name={item.icon} /></span>
          <span class="prod__rol">{item.rol}</span>
        </div>
        <h2 class="h3">{item.nombre}</h2>
        <p>{item.texto}</p>
        <a href={hrefFor(item)} class="link-arrow">
          {item.cta}
          <Icon name="arrow" size={16} />
        </a>
      </article>
    ))}
  </div>
</section>

<SectionCTA
  titulo={t.home.ctaFinal.titulo}
  sub={t.home.ctaFinal.sub}
  primaryHref={pagePath(lang, 'contacto')}
  primaryLabel={t.home.ctaFinal.ctaPrimario}
  secondaryHref={pagePath(lang, 'casos')}
  secondaryLabel={t.nav.casos}
/>

<style>
  .prod__grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 860px) {
    .prod__grid { grid-template-columns: repeat(2, 1fr); }
  }

  .prod__card {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: 2rem;
  }

  .prod__card--destacado {
    box-shadow: 0 24px 70px -30px rgba(24, 214, 241, 0.35);
  }

  .prod__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .prod__rol {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-cyan);
    border: 1px solid rgba(24, 214, 241, 0.3);
    background: rgba(24, 214, 241, 0.07);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .prod__card .link-arrow { margin-top: 0.4rem; }
</style>
