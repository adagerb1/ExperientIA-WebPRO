---
import PageHero from '../PageHero.astro';
import SectionCTA from '../SectionCTA.astro';
import DashboardMock from '../DashboardMock.astro';
import Icon from '../Icon.astro';
import { getDict, pagePath } from '../../i18n/index.js';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getDict(lang);
const p = t.tablero;
---

<PageHero eyebrow={p.hero.eyebrow} titulo={p.hero.titulo} sub={p.hero.sub}>
  <div class="tab-hero__actions reveal" style="--reveal-delay:.24s">
    <a href={pagePath(lang, 'contacto')} class="btn btn-primary">{p.hero.cta}</a>
  </div>
</PageHero>

<section class="tab-visual">
  <div class="container">
    <div class="tab-visual__stage reveal">
      <div class="bg-atmos" aria-hidden="true">
        <div class="halo halo-cyan anim-pulse" style="width:560px;height:560px;top:-180px;left:8%;"></div>
        <div class="halo halo-violet anim-pulse" style="width:520px;height:520px;bottom:-220px;right:4%;animation-delay:2.2s;"></div>
      </div>
      <DashboardMock lang={lang} class="tab-visual__dash" />
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="grid grid-3">
      {p.pilares.map((pilar, i) => (
        <article class="card card-lum tab-pilar reveal" style={`--reveal-delay:${i * 0.1}s`}>
          <span class="icon-chip"><Icon name={pilar.icon} /></span>
          <h2 class="h3">{pilar.titulo}</h2>
          <p>{pilar.texto}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section tab-features">
  <div class="bg-atmos" aria-hidden="true">
    <div class="halo halo-violet" style="width:460px;height:460px;top:0;left:-240px;opacity:.28;"></div>
  </div>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow reveal">{p.features.eyebrow}</p>
      <h2 class="h2 reveal" style="--reveal-delay:.08s">{p.features.titulo}</h2>
    </div>
    <div class="grid grid-4">
      {p.features.items.map((f, i) => (
        <article class="card reveal" style={`--reveal-delay:${i * 0.08}s`}>
          <span class="icon-chip"><Icon name={f.icon} /></span>
          <h3 class="h3 tab-features__titulo">{f.titulo}</h3>
          <p class="small">{f.texto}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<SectionCTA
  titulo={p.cta.titulo}
  sub={p.cta.sub}
  primaryHref={pagePath(lang, 'contacto')}
  primaryLabel={p.cta.cta}
  secondaryHref={pagePath(lang, 'soluciones')}
  secondaryLabel={t.common.verSoluciones}
/>

<style>
  .tab-hero__actions {
    display: flex;
    gap: 0.9rem;
    margin-top: 0.5rem;
  }

  .tab-visual {
    position: relative;
    padding-block: clamp(1rem, 3vw, 2rem);
  }

  .tab-visual__stage {
    position: relative;
    padding: clamp(1.5rem, 4vw, 3.5rem);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .tab-visual__dash {
    position: relative;
    z-index: 1;
    max-width: 760px;
    margin-inline: auto;
  }

  .tab-pilar {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .tab-features .card {
    display: grid;
    gap: 0.8rem;
    align-content: start;
  }

  .tab-features__titulo { font-size: 1.05rem; }
</style>
