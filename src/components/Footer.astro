---
import BrandLogo from './BrandLogo.astro';
import { LANGS, getDict, pagePath, CONTACT_EMAIL, TONNY_DAGER_URL } from '../i18n/index.js';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getDict(lang);
const year = new Date().getFullYear();

const colSoluciones = ['soluciones', 'tablero', 'productos'];
const colCompania = ['casos', 'recursos', 'nosotros', 'contacto'];
---

<footer class="site-footer">
  <div class="container">
    <hr class="divider" />
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a href={pagePath(lang, 'home')} aria-label="ExperientIA">
          <BrandLogo variant="gradient" descriptor={true} size={46} />
        </a>
        <p class="site-footer__tagline">{t.footer.tagline}</p>
      </div>

      <nav aria-label={t.footer.colSoluciones}>
        <h2 class="site-footer__title">{t.footer.colSoluciones}</h2>
        <ul>
          {colSoluciones.map((k) => (
            <li><a href={pagePath(lang, k)}>{t.nav[k]}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.colCompania}>
        <h2 class="site-footer__title">{t.footer.colCompania}</h2>
        <ul>
          {colCompania.map((k) => (
            <li><a href={pagePath(lang, k)}>{t.nav[k]}</a></li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class="site-footer__title">{t.footer.colContacto}</h2>
        <ul>
          <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
          <li><span class="site-footer__muted">{t.footer.contactoLinea}</span></li>
        </ul>
        <h2 class="site-footer__title site-footer__title--langs">{t.footer.idiomas}</h2>
        <div class="site-footer__langs">
          {LANGS.map((l) => (
            <a href={pagePath(l, 'home')} class:list={[{ 'is-active': l === lang }]} lang={l}>{l.toUpperCase()}</a>
          ))}
        </div>
      </div>
    </div>

    <div class="site-footer__legal">
      <p>© {year} ExperientIA. {t.footer.legal}</p>
      <p>
        {t.footer.ecosistema}
        <a href={TONNY_DAGER_URL} rel="noopener" target="_blank">Tonny Dager</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding: clamp(3rem, 6vw, 5rem) 0 2rem;
    background: linear-gradient(to bottom, transparent, rgba(10, 27, 58, 0.35));
  }

  .site-footer__grid {
    display: grid;
    gap: 2.5rem;
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width: 860px) {
    .site-footer__grid {
      grid-template-columns: 1.6fr 1fr 1fr 1.3fr;
      gap: 2rem;
    }
  }

  .site-footer__brand {
    display: grid;
    gap: 1.2rem;
    align-content: start;
    justify-items: start;
  }

  .site-footer__tagline {
    max-width: 26ch;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .site-footer__title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin: 0 0 1rem;
  }

  .site-footer__title--langs { margin-top: 1.75rem; }

  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }

  .site-footer ul a {
    color: var(--text-secondary);
    font-size: 0.925rem;
    transition: color 0.2s ease;
  }

  .site-footer ul a:hover { color: var(--accent-cyan); }

  .site-footer__muted {
    color: var(--text-tertiary);
    font-size: 0.85rem;
  }

  .site-footer__langs {
    display: inline-flex;
    gap: 0.15rem;
    padding: 0.2rem;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
  }

  .site-footer__langs a {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
  }

  .site-footer__langs a:hover { color: var(--neutral-light); }

  .site-footer__langs a.is-active {
    color: #041022;
    background: var(--accent-cyan);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    justify-content: space-between;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-soft);
  }

  .site-footer__legal p {
    font-size: 0.8rem;
    color: var(--text-tertiary);
  }

  .site-footer__legal a {
    color: var(--text-secondary);
  }

  .site-footer__legal a:hover { color: var(--accent-cyan); }
</style>
