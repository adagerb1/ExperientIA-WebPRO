---
/**
 * Símbolo ExperientIA — recreación vectorial fiel del asset oficial.
 * Expresa convergencia (formas que se unen al centro), impulso (diagonales
 * hacia adelante) y transformación (flujo entre cian y violeta).
 *
 * variant: 'gradient' (principal) | 'white' | 'black' | 'current'
 */
interface Props {
  variant?: 'gradient' | 'white' | 'black' | 'current';
  size?: number;
  class?: string;
}

const { variant = 'gradient', size = 40, class: className } = Astro.props;
const uid = 'xg-' + Math.random().toString(36).slice(2, 8);

const solidFill =
  variant === 'white' ? '#ffffff'
  : variant === 'black' ? '#0a1224'
  : variant === 'current' ? 'currentColor'
  : `url(#${uid})`;

const strokeFill =
  variant === 'white' ? '#ffffff'
  : variant === 'black' ? '#0a1224'
  : variant === 'current' ? 'currentColor'
  : '#00e5ff';
---

<svg
  class={className}
  width={size * 1.28}
  height={size}
  viewBox="0 0 128 100"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-hidden="true"
>
  {variant === 'gradient' && (
    <defs>
      <linearGradient id={uid} x1="18" y1="0" x2="50" y2="100" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#00e5ff" />
        <stop offset="0.52" stop-color="#7b61ff" />
        <stop offset="1" stop-color="#00e5ff" />
      </linearGradient>
    </defs>
  )}

  <!-- Pennant sólido: convergencia hacia el centro -->
  <path
    fill={solidFill}
    d="M 6 2 L 38 2 L 64 41.5 L 64 58.5 L 38 98 L 6 98 L 6 55.5 L 12.5 52 L 12.5 48 L 6 44.5 Z"
  />

  <!-- Trazos angulares: la mitad derecha de la X, con cortes tecnológicos -->
  <g stroke={strokeFill} fill="none" stroke-width="10.5">
    <!-- Chevron central: convergencia hacia el punto de cruce -->
    <polyline points="88,26.5 72,50 88,73.5" />
    <!-- Codo superior: diagonal + cap horizontal -->
    <polyline points="61.5,32 78.5,7.25 96,7.25" />
    <!-- Eco exterior superior -->
    <line x1="102.5" y1="6" x2="124" y2="31.5" stroke-width="11" />
    <!-- Codo inferior -->
    <polyline points="61.5,68 78.5,92.75 96,92.75" />
    <!-- Eco exterior inferior -->
    <line x1="102.5" y1="94" x2="124" y2="68.5" stroke-width="11" />
  </g>
</svg>
