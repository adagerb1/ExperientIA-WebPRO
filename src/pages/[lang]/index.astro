---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import DashboardMock from '../../components/DashboardMock.astro';
import SectionCTA from '../../components/SectionCTA.astro';
import { LANGS, getDict, pagePath } from '../../i18n/index.js';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = getDict(lang);
const h = t.home;
---

<Base lang={lang} pageKey={null}>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="bg-atmos" aria-hidden="true">
      <div class="bg-grid"></div>
      <div class="halo halo-cyan anim-pulse" style="width:640px;height:640px;top:-300px;right:-180px;"></div>
      <div class="halo halo-violet anim-pulse" style="width:520px;height:520px;bottom:-200px;left:-220px;animation-delay:2.6s;"></div>
      <div class="bg-skyline"></div>
    </div>

    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow reveal">{h.hero.eyebrow}</p>
        <h1 class="display reveal" style="--reveal-delay:.08s">
          {h.hero.titulo1}<br />
          <span class="grad-text">{h.hero.titulo2}</span>
        </h1>
        <p class="lead reveal" style="--reveal-delay:.16s">{h.hero.sub}</p>
        <div class="hero__actions reveal" style="--reveal-delay:.24s">
          <a href={pagePath(lang, 'contacto')} class="btn btn-primary">{h.hero.ctaPrimario}</a>
          <a href={pagePath(lang, 'tablero')} class="btn btn-ghost">{h.hero.ctaSecundario}</a>
        </div>
        <p class="small reveal" style="--reveal-delay:.32s">{h.hero.nota}</p>
      </div>

      <div class="hero__visual reveal" style="--reveal-delay:.2s">
        <DashboardMock lang={lang} class="anim-float" />
      </div>
    </div>
  </section>

  <!-- ============ PRUEBA SOCIAL ============ -->
  <section class="section proof">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">{h.proof.eyebrow}</p>
        <h2 class="h2 reveal" style="--reveal-delay:.08s">{h.proof.titulo}</h2>
      </div>
      <div class="grid grid-4">
        {h.proof.metrics.map((m, i) => (
          <article class="card proof__card reveal" style={`--reveal-delay:${i * 0.08}s`}>
            <p class="proof__valor grad-text">{m.valor}</p>
            <h3 class="h3">{m.label}</h3>
            <p class="small">{m.detalle}</p>
          </article>
        ))}
      </div>
      <p class="proof__sectores small reveal">{h.proof.sectores}</p>
    </div>
  </section>

  <!-- ============ PROBLEMA ============ -->
  <section class="section problema">
    <div class="bg-atmos" aria-hidden="true">
      <div class="halo halo-violet" style="width:480px;height:480px;top:10%;right:-240px;opacity:.3;"></div>
    </div>
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">{h.problema.eyebrow}</p>
        <h2 class="h2 reveal" style="--reveal-delay:.08s">{h.problema.titulo}</h2>
        <p class="lead reveal" style="--reveal-delay:.16s">{h.problema.sub}</p>
      </div>
      <div class="grid grid-3">
        {h.problema.bloques.map((b, i) => (
          <article class="card reveal" style={`--reveal-delay:${i * 0.1}s`}>
            <span class="icon-chip"><Icon name={b.icon} /></span>
            <h3 class="h3 problema__titulo">{b.titulo}</h3>
            <p>{b.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ TABLERO DE CRECIMIENTO ============ -->
  <section class="section tablero-home">
    <div class="container tablero-home__inner">
      <div class="tablero-home__copy">
        <p class="eyebrow reveal">{h.tablero.eyebrow}</p>
        <h2 class="h2 reveal" style="--reveal-delay:.08s">{h.tablero.titulo}</h2>
        <p class="lead reveal" style="--reveal-delay:.16s">{h.tablero.sub}</p>
        <ul class="tablero-home__bullets">
          {h.tablero.bullets.map((b, i) => (
            <li class="reveal" style={`--reveal-delay:${0.2 + i * 0.08}s`}>
              <span class="tablero-home__check"><Icon name="check" size={14} /></span>
              {b}
            </li>
          ))}
        </ul>
        <a href={pagePath(lang, 'tablero')} class="link-arrow reveal" style="--reveal-delay:.44s">
          {h.tablero.cta}
          <Icon name="arrow" size={16} />
        </a>
      </div>
      <div class="tablero-home__visual reveal" style="--reveal-delay:.15s">
        <DashboardMock lang={lang} />
      </div>
    </div>
  </section>

  <!-- ============ SOLUCIONES ============ -->
  <section class="section soluciones-home">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">{h.soluciones.eyebrow}</p>
        <h2 class="h2 reveal" style="--reveal-delay:.08s">{h.soluciones.titulo}</h2>
        <p class="lead reveal" style="--reveal-delay:.16s">{h.soluciones.sub}</p>
      </div>
      <div class="grid grid-2">
        {t.soluciones.items.map((s, i) => (
          <article class="card card-lum reveal" style={`--reveal-delay:${i * 0.08}s`}>
            <div class="soluciones-home__head">
              <span class="icon-chip"><Icon name={s.icon} /></span>
              <span class="soluciones-home__pilar">{s.pilar}</span>
            </div>
            <h3 class="h3">{s.titulo}</h3>
            <p>{s.cambia}</p>
          </article>
        ))}
      </div>
      <div class="section-foot reveal">
        <a href={pagePath(lang, 'soluciones')} class="btn btn-ghost">{h.soluciones.cta}</a>
      </div>
    </div>
  </section>

  <!-- ============ CASOS ============ -->
  <section class="section casos-home">
    <div class="bg-atmos" aria-hidden="true">
      <div class="halo halo-cyan" style="width:460px;height:460px;bottom:-200px;left:-220px;opacity:.28;"></div>
    </div>
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">{h.casos.eyebrow}</p>
        <h2 class="h2 reveal" style="--reveal-delay:.08s">{h.casos.titulo}</h2>
        <p class="lead reveal" style="--reveal-delay:.16s">{h.casos.sub}</p>
      </div>
      <div class="grid grid-3">
        {t.casos.items.map((c, i) => (
          <article class="card reveal" style={`--reveal-delay:${i * 0.1}s`}>
            <p class="casos-home__sector">{c.sector}</p>
            <h3 class="h3">{c.titulo}</h3>
            <p class="casos-home__metric grad-text">{c.resultados[0].valor}</p>
            <p class="small">{c.resultados[0].label}</p>
          </article>
        ))}
      </div>
      <div class="section-foot reveal">
        <a href={pagePath(lang, 'casos')} class="link-arrow">
          {h.casos.cta}
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- ============ CTA FINAL ============ -->
  <SectionCTA
    titulo={h.ctaFinal.titulo}
    sub={h.ctaFinal.sub}
    primaryHref={pagePath(lang, 'contacto')}
    primaryLabel={h.ctaFinal.ctaPrimario}
    secondaryHref={pagePath(lang, 'soluciones')}
    secondaryLabel={h.ctaFinal.ctaSecundario}
  />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding: calc(76px + clamp(3.5rem, 9vw, 7rem)) 0 clamp(3.5rem, 8vw, 6rem);
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 1020px) {
    .hero__inner {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }

  .hero__copy {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }

  .hero__copy .lead { max-width: 34rem; }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .hero__visual {
    min-width: 0;
  }

  /* ---------- Prueba social ---------- */
  .proof__card {
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }

  .proof__valor {
    font-size: clamp(2rem, 4vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .proof__card .h3 { font-size: 1.02rem; }

  .proof__sectores {
    margin-top: 2rem;
    text-align: center;
  }

  /* ---------- Problema ---------- */
  .problema .card {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  /* ---------- Tablero home ---------- */
  .tablero-home__inner {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 1020px) {
    .tablero-home__inner {
      grid-template-columns: 0.95fr 1.05fr;
    }
  }

  .tablero-home__copy {
    display: grid;
    gap: 1.2rem;
    justify-items: start;
  }

  .tablero-home__bullets {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .tablero-home__bullets li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    color: var(--text-secondary);
  }

  .tablero-home__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 7px;
    color: var(--accent-cyan);
    background: rgba(24, 214, 241, 0.1);
    border: 1px solid rgba(24, 214, 241, 0.3);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* ---------- Soluciones home ---------- */
  .soluciones-home .card {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }

  .soluciones-home__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .soluciones-home__pilar {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-violet);
    border: 1px solid rgba(122, 99, 255, 0.35);
    background: rgba(122, 99, 255, 0.08);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  /* ---------- Casos home ---------- */
  .casos-home .card {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .casos-home__sector {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .casos-home__metric {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    margin-top: 0.4rem;
  }

  /* ---------- Comunes ---------- */
  .section-foot {
    display: flex;
    justify-content: center;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
</style>
