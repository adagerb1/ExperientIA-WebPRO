---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LANGS, getDict, pagePath, CONTACT_EMAIL } from '../i18n/index.js';

interface Props {
  lang: string;
  pageKey?: string | null;
  title?: string;
  description?: string;
}

const { lang, pageKey = null, title, description } = Astro.props;
const t = getDict(lang);

const pageTitle = title ? `${title} · ExperientIA` : t.meta.titleBase;
const pageDescription = description ?? t.meta.description;

const site = Astro.site ?? new URL('https://experientia.example.com');
const canonical = new URL(pagePath(lang, pageKey ?? 'home'), site);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ExperientIA',
  slogan: 'Automatización · Growth · IA',
  description: t.meta.description,
  url: site.toString(),
  email: CONTACT_EMAIL,
  logo: new URL('/favicon.svg', site).toString(),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#051126" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(pagePath(l, pageKey ?? 'home'), site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(pagePath('es', pageKey ?? 'home'), site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ExperientIA" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.common.breadcrumbHome}</a>
    <Header lang={lang} pageKey={pageKey} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Motion: reveals con IntersectionObserver + contadores.
      // Performance first: se desactiva con prefers-reduced-motion.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const reveals = document.querySelectorAll('.reveal');
      if (reduced || !('IntersectionObserver' in window)) {
        reveals.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        reveals.forEach((el) => io.observe(el));
      }

      // Header: estado con scroll.
      const header = document.querySelector('[data-header]');
      if (header) {
        const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
  </body>
</html>
